generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model LUDI_COMMON_GRADE {
  id              Int                        @id @default(autoincrement())
  grade_type_name String
  grade_type_desc String?
  created_date    DateTime                   @default(now())
  modified_date   DateTime                   @default(now())
  image_url       String?
  key_string      String?
  ludiactividades LudiActividad[]
  images          LUDI_COMMON_GRADE_IMAGES[]
  misiones        LudiMision[]
  materias        LudiMateriaGrado[]
  usuariosMateria LudiUsuarioMateria[]
  colecciones     LudiPlantillaColeccion[]
}

model LUDI_COMMON_GRADE_IMAGES {
  id          Int               @id @default(autoincrement())
  grade_id    Int
  image_url   String
  description String?
  grade       LUDI_COMMON_GRADE @relation(fields: [grade_id], references: [id])
}

model ACTIVITY {
  id              Int            @id @default(autoincrement())
  activity_name   String         @db.VarChar(100)
  activity_desc   String?        @db.VarChar(100)
  created_date    DateTime       @default(now())
  modified_date   DateTime       @default(now())
  image_url       String?        @db.VarChar(100)
  isTemplate      Boolean?       @default(false) @map("isTemplate")
  ludiactividades LudiActividad?
}

model LudiActividad {
  activityId        Int     @id(map: "PK__LUDI_ACT__482FBD6332AE6D54") @map("activity_id")
  tipoActividadId   Int     @map("tipo_actividad_id") @db.TinyInt
  userId            String  @map("user_id")
  gradoId           Int?    @map("grado_id")
  temaId            BigInt? @map("tema_id")
  publico           Boolean @default(false, map: "DF_LUDI_ACT_publico")
  estatus           Boolean @default(true) @map("estatus")
  // Plantilla de la que se copió; agrupa en el reporte admin las copias de distintos docentes.
  plantillaOrigenId Int?    @map("plantilla_origen_id")

  activity       ACTIVITY                @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK__LUDI_ACTI__activ__32767D0B")
  user           LudiUser                @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "FK_LudiActividad_User")
  grado          LUDI_COMMON_GRADE?      @relation(fields: [gradoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__LUDI_ACTI__grado__3552E9B6")
  tema           LudiTema?               @relation(fields: [temaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__LUDI_ACTI__tema___36470DEF")
  tipoActividad  LudiTipoActividad       @relation(fields: [tipoActividadId], references: [id], onUpdate: NoAction, map: "FK__LUDI_ACTI__tipo___336AA144")
  config         LudiActividadConfig?
  memoriaParejas LudiMemoriaPareja[]     @relation("MemoriaParejaActivity")
  preguntas      LudiPregunta[]          @relation("PreguntaActivity")
  LUDI_SESION    LUDI_SESION[]
  insignias      LudiActividadInsignia[]
  misiones       LudiActividadMision[]

  plantillaOrigen LudiActividad?  @relation("PlantillaOrigen", fields: [plantillaOrigenId], references: [activityId], onDelete: NoAction, onUpdate: NoAction)
  copias          LudiActividad[] @relation("PlantillaOrigen")
  plantilla       LudiPlantilla?

  @@map("LUDI_ACTIVIDAD")
}

model LudiActividadConfig {
  activityId       Int                   @id(map: "PK__LUDI_ACT__482FBD630AF4F7DC") @map("activity_id")
  tiempoPreguntaMs Int?                  @map("tiempo_pregunta_ms")
  tipoPuntuacionId Int                   @default(1, map: "DF_LUDI_ACTCFG_tipoPunt") @map("tipo_puntuacion_id") @db.TinyInt
  puntajeBase      Int                   @default(1000, map: "DF_LUDI_ACTCFG_puntaje") @map("puntaje_base")
  feedbackId       Int?                  @map("feedback_id")
  ajustesJson      String?               @map("ajustes_json") @db.NVarChar(Max)
  activity         LudiActividad         @relation(fields: [activityId], references: [activityId], onDelete: Cascade, onUpdate: NoAction, map: "FK__LUDI_ACTI__activ__3A179ED3")
  feedback         LudiComponenteLudico? @relation(fields: [feedbackId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__LUDI_ACTI__feedb__3DE82FB7")
  tipoPuntuacion   LudiTipoPuntuacion    @relation(fields: [tipoPuntuacionId], references: [id], onUpdate: NoAction, map: "FK__LUDI_ACTI__tipo___3B0BC30C")

  @@map("LUDI_ACTIVIDAD_CONFIG")
}

model LudiComponenteLudico {
  id         Int                   @id(map: "PK__LUDI_COM__3213E83F85CE91FE") @default(autoincrement())
  tipoId     Int                   @map("tipo_id") @db.TinyInt
  nombre     String                @db.NVarChar(80)
  assetUrl   String?               @map("asset_url") @db.NVarChar(600)
  configJson String?               @map("config_json") @db.NVarChar(Max)
  configs    LudiActividadConfig[]
  tipo       LudiTipoFeedback      @relation(fields: [tipoId], references: [id], onUpdate: NoAction, map: "FK__LUDI_COMP__tipo___2F9A1060")

  @@map("LUDI_COMPONENTE_LUDICO")
}

model LudiMemoriaPareja {
  id         BigInt               @id(map: "PK__LUDI_MEM__3213E83FE16E28DC") @default(autoincrement())
  activityId Int                  @map("activity_id")
  etiqueta   String?              @db.NVarChar(80)
  activity   LudiActividad        @relation("MemoriaParejaActivity", fields: [activityId], references: [activityId], onDelete: Cascade, onUpdate: NoAction, map: "FK_MemoriaPareja_Activity")
  tarjetas   LudiMemoriaTarjeta[]

  @@map("LUDI_MEMORIA_PAREJA")
}

model LudiMemoriaTarjeta {
  id        BigInt            @id(map: "PK__LUDI_MEM__3213E83FD3AE0800") @default(autoincrement())
  parejaId  BigInt            @map("pareja_id")
  recursoId BigInt            @map("recurso_id")
  lado      String            @db.Char(1)
  pareja    LudiMemoriaPareja @relation(fields: [parejaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK__LUDI_MEMO__parej__5C6CB6D7")
  recurso   LudiRecurso       @relation(fields: [recursoId], references: [id], onUpdate: NoAction, map: "FK__LUDI_MEMO__recur__5D60DB10")

  @@unique([parejaId, lado], map: "UQ_LUDI_MEM_tarjeta")
  @@map("LUDI_MEMORIA_TARJETA")
}

model LudiOpcion {
  id             BigInt                    @id(map: "PK__LUDI_OPC__3213E83F58810239") @default(autoincrement())
  preguntaId     BigInt                    @map("pregunta_id")
  indice         Int                       @db.TinyInt
  texto          String?                   @db.NVarChar(400)
  esCorrecta     Boolean                   @default(false, map: "DF_LUDI_OPC_correcta") @map("es_correcta")
  pregunta       LudiPregunta              @relation(fields: [preguntaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK__LUDI_OPCI__pregu__5006DFF2")
  opcionRecursos LudiOpcionRecurso[]
  respuestas     LudiRespuestaEstudiante[]

  @@unique([preguntaId, indice], map: "UQ_LUDI_OPC_pre_ind")
  @@map("LUDI_OPCION")
}

model LudiOpcionRecurso {
  opcionId  BigInt      @map("opcion_id")
  recursoId BigInt      @map("recurso_id")
  rol       String      @db.NVarChar(20)
  opcion    LudiOpcion  @relation(fields: [opcionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK__LUDI_OPCI__opcio__53D770D6")
  recurso   LudiRecurso @relation(fields: [recursoId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK__LUDI_OPCI__recur__54CB950F")

  @@id([opcionId, recursoId, rol], map: "PK__LUDI_OPC__A930ED371C9C42E1")
  @@map("LUDI_OPCION_RECURSO")
}

model LudiOrigenRecurso {
  id       Int           @id(map: "PK__LUDI_ORI__3213E83F68533875") @db.TinyInt
  nombre   String        @unique(map: "UQ__LUDI_ORI__72AFBCC617D2E32D") @db.NVarChar(20)
  recursos LudiRecurso[]

  @@map("LUDI_ORIGEN_RECURSO")
}

model LudiPregunta {
  id               BigInt                    @id(map: "PK__LUDI_PRE__3213E83F7B9AA76F") @default(autoincrement())
  activityId       Int                       @map("activity_id")
  numero           Int                       @db.SmallInt
  tipoActividadId  Int                       @map("tipo_actividad_id") @db.TinyInt
  enunciado        String                    @db.NVarChar(Max)
  tiempoLimiteMs   Int?                      @map("tiempo_limite_ms")
  puntaje          Int?
  activo           Boolean                   @default(true, map: "DF_LUDI_PREG_activo")
  // Diapositiva de contenido (p. ej. Canva): sin opciones, sin tiempo y sin puntaje.
  esContenido      Boolean                   @default(false, map: "DF_LUDI_PREG_contenido") @map("es_contenido")
  // Cuerpo de los bloques de lectura de LudiLección (el título va en enunciado).
  contenidoTexto   String?                   @map("contenido_texto") @db.NVarChar(Max)
  // LudiForm: "single" | "multiple" | "long". Null en el resto de actividades (opción única).
  tipoPregunta     String?                   @map("tipo_pregunta") @db.NVarChar(20)
  opciones         LudiOpcion[]
  activity         LudiActividad             @relation("PreguntaActivity", fields: [activityId], references: [activityId], onDelete: Cascade, onUpdate: NoAction, map: "FK_Pregunta_Activity")
  tipoActividad    LudiTipoActividad         @relation(fields: [tipoActividadId], references: [id], onUpdate: NoAction, map: "FK__LUDI_PREG__tipo___467D75B8")
  preguntaRecursos LudiPreguntaRecurso[]
  respuestas       LudiRespuestaEstudiante[]

  @@unique([activityId, numero], map: "UQ_LUDI_PREG_act_num")
  @@map("LUDI_PREGUNTA")
}

model LudiPreguntaRecurso {
  preguntaId BigInt       @map("pregunta_id")
  recursoId  BigInt       @map("recurso_id")
  rol        String       @db.NVarChar(20)
  pregunta   LudiPregunta @relation(fields: [preguntaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK__LUDI_PREG__pregu__4A4E069C")
  recurso    LudiRecurso  @relation(fields: [recursoId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK__LUDI_PREG__recur__4B422AD5")

  @@id([preguntaId, recursoId, rol], map: "PK__LUDI_PRE__E29AD22F0CA2C29F")
  @@map("LUDI_PREGUNTA_RECURSO")
}

model LudiRecurso {
  id               BigInt                @id(map: "PK__LUDI_REC__3213E83FF642418B") @default(autoincrement())
  tipoId           Int                   @map("tipo_id") @db.TinyInt
  origenId         Int                   @map("origen_id") @db.TinyInt
  url              String                @db.NVarChar(600)
  externalId       String?               @map("external_id") @db.NVarChar(128)
  titulo           String?               @db.NVarChar(200)
  creditos         String?               @db.NVarChar(200)
  anchoPx          Int?                  @map("ancho_px")
  altoPx           Int?                  @map("alto_px")
  duracionMs       Int?                  @map("duracion_ms")
  metadataJson     String?               @map("metadata_json") @db.NVarChar(Max)
  memoriaTarjetas  LudiMemoriaTarjeta[]
  opcionRecursos   LudiOpcionRecurso[]
  preguntaRecursos LudiPreguntaRecurso[]
  origen           LudiOrigenRecurso     @relation(fields: [origenId], references: [id], onUpdate: NoAction, map: "FK__LUDI_RECU__orige__41B8C09B")
  tipo             LudiTipoRecurso       @relation(fields: [tipoId], references: [id], onUpdate: NoAction, map: "FK__LUDI_RECU__tipo___40C49C62")

  @@index([origenId, externalId], map: "IX_LUDI_RECURSO_origen_ext")
  @@map("LUDI_RECURSO")
}

model LudiTema {
  id          BigInt          @id(map: "PK__LUDI_TEM__3213E83F78611B40") @default(autoincrement())
  nombre      String          @db.NVarChar(80)
  imageUrl    String          @map("image_url") @db.NVarChar(600)
  descripcion String?         @db.NVarChar(300)
  activo      Boolean         @default(true, map: "DF_LUDI_TEMA_activo")
  actividades LudiActividad[]

  @@map("LUDI_TEMA")
}

model LudiTipoActividad {
  id          Int             @id(map: "PK__LUDI_TIP__3213E83F41FA798F") @db.TinyInt
  nombre      String          @unique(map: "UQ__LUDI_TIP__72AFBCC60DE48EAA") @db.NVarChar(40)
  actividades LudiActividad[]
  preguntas   LudiPregunta[]

  @@map("LUDI_TIPO_ACTIVIDAD")
}

model LudiTipoFeedback {
  id          Int                    @id(map: "PK__LUDI_TIP__3213E83F02C7D7CD") @db.TinyInt
  nombre      String                 @unique(map: "UQ__LUDI_TIP__72AFBCC64282437F") @db.NVarChar(40)
  componentes LudiComponenteLudico[]

  @@map("LUDI_TIPO_FEEDBACK")
}

model LudiTipoPuntuacion {
  id      Int                   @id(map: "PK__LUDI_TIP__3213E83F139ECB51") @db.TinyInt
  nombre  String                @unique(map: "UQ__LUDI_TIP__72AFBCC6DEF81825") @db.NVarChar(30)
  configs LudiActividadConfig[]

  @@map("LUDI_TIPO_PUNTUACION")
}

model LudiTipoRecurso {
  id       Int           @id(map: "PK__LUDI_TIP__3213E83F410C3E21") @db.TinyInt
  nombre   String        @unique(map: "UQ__LUDI_TIP__72AFBCC676919663") @db.NVarChar(20)
  recursos LudiRecurso[]

  @@map("LUDI_TIPO_RECURSO")
}

model LUDI_SESION {
  id                       BigInt                     @id(map: "PK__LUDI_SES__3213E83FFE0EE0FD") @default(autoincrement())
  activity_id              Int
  userId                   String                     @map("user_id")
  codigo                   String                     @unique(map: "UQ__LUDI_SES__40F9A2061D1921D8") @db.Char(6)
  estado                   String                     @default("ESPERANDO") @db.NVarChar(50)
  modoJuego                String                     @default("ESTUDIANTE") @map("modoJuego") @db.NVarChar(50)
  preguntaActualIndex      Int                        @default(0) @map("preguntaActualIndex")
  // Evaluación del docente (src/features/followUp): efectividad 1-5, objetivo y, en copias de plantilla, dificultad.
  teacherRating            Float?                     @map("teacher_rating")
  templateDifficulty       String?                    @map("template_difficulty") @db.NVarChar(50)
  // Obsoleto: ya no se pregunta. Se conserva por compatibilidad.
  classEngagement          Int?                       @map("class_engagement")
  // Obsoleto: reemplazado por objectiveLevel, que admite "Parcialmente".
  objectiveMet             Boolean?                   @map("objective_met")
  // 0 = No, 1 = Parcialmente, 2 = Sí (ver OBJECTIVE_LEVELS).
  objectiveLevel           Int?                       @map("objective_level") @db.TinyInt
  iniciada_en              DateTime?
  finalizada_en            DateTime?
  creada_en                DateTime                   @default(dbgenerated("sysdatetime()"), map: "DF_LUDI_SES_creada")
  LUDI_ACTIVIDAD           LudiActividad              @relation(fields: [activity_id], references: [activityId], onDelete: Cascade, onUpdate: NoAction, map: "FK__LUDI_SESI__activ__6225902D")
  user                     LudiUser                   @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "FK_LudiSesion_User")
  LUDI_SESION_PARTICIPANTE LUDI_SESION_PARTICIPANTE[]
}

model LUDI_SESION_PARTICIPANTE {
  id               BigInt                     @id(map: "PK__LUDI_SES__3213E83F49938736") @default(autoincrement())
  sesion_id        BigInt
  nombre           String                     @db.NVarChar(80)
  unido_en         DateTime                   @default(dbgenerated("sysdatetime()"), map: "DF_LUDI_PART_unido")
  puntaje_total    Int                        @default(0, map: "DF_LUDI_PART_punt")
  avatarId         Int?                       @map("avatarId")
  completado       Boolean                    @default(false)
  // Obsoleto: promedio heredado de gusto y aprendizaje; ya no se escribe.
  studentRating    Float?                     @map("student_rating")
  studentEnjoyment Float?                     @map("student_enjoyment")
  studentLearning  Float?                     @map("student_learning")
  // SHA-256 del código secreto entregado al unirse; null en participantes previos a este control.
  token_hash       String?                    @db.Char(64)
  LUDI_SESION      LUDI_SESION                @relation(fields: [sesion_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK__LUDI_SESI__sesio__69C6B1F5")
  avatar           LudiAvatar?                @relation(fields: [avatarId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  respuestas       LudiRespuestaEstudiante[]
  insignias        LudiParticipanteInsignia[]
  misiones         LudiParticipanteMision[]

  @@unique([sesion_id, nombre], map: "UQ_LUDI_PART_ses_nom")
}

// Catálogo de logros. Los textos visibles se traducen en messages/{es,en}.json
// (Achievements.badges.<codigo> y Achievements.missions.<catalogo>.<regla>);
// aquí solo vive lo que define cómo se gana cada uno.
// catalogo: quiz | lesson | form | memory (ver src/features/gamification/catalog.ts)
model LudiInsignia {
  id       Int     @id @default(autoincrement())
  codigo   String  @unique(map: "UQ_LUDI_INSIGNIA_codigo") @db.NVarChar(50)
  catalogo String  @db.NVarChar(20)
  regla    String  @db.NVarChar(40)
  // Parámetro de la regla: segundos, palabras o porcentaje según la regla.
  umbral   Int?
  imagen   String  @db.NVarChar(200)
  color    String  @db.NVarChar(9)
  orden    Int     @default(0)
  // Retirar una insignia es activo = false: las FK impiden borrarla mientras esté en uso.
  activo   Boolean @default(true)

  actividades   LudiActividadInsignia[]
  participantes LudiParticipanteInsignia[]

  @@index([catalogo, activo], map: "IX_LUDI_INSIGNIA_catalogo")
  @@map("LUDI_INSIGNIA")
}

model LudiMision {
  id       Int               @id @default(autoincrement())
  codigo   String            @unique(map: "UQ_LUDI_MISION_codigo") @db.NVarChar(50)
  catalogo String            @db.NVarChar(20)
  gradoId  Int               @map("grado_id")
  regla    String            @db.NVarChar(40)
  umbral   Int?
  orden    Int               @default(0)
  activo   Boolean           @default(true)
  grado    LUDI_COMMON_GRADE @relation(fields: [gradoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  actividades   LudiActividadMision[]
  participantes LudiParticipanteMision[]

  @@index([catalogo, gradoId, activo], map: "IX_LUDI_MISION_catalogo_grado")
  @@map("LUDI_MISION")
}

// Insignias y misiones que el docente eligió para una actividad.
model LudiActividadInsignia {
  activityId Int           @map("activity_id")
  insigniaId Int           @map("insignia_id")
  activity   LudiActividad @relation(fields: [activityId], references: [activityId], onDelete: Cascade, onUpdate: NoAction)
  insignia   LudiInsignia  @relation(fields: [insigniaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([activityId, insigniaId])
  @@map("LUDI_ACTIVIDAD_INSIGNIA")
}

model LudiActividadMision {
  activityId Int           @map("activity_id")
  misionId   Int           @map("mision_id")
  activity   LudiActividad @relation(fields: [activityId], references: [activityId], onDelete: Cascade, onUpdate: NoAction)
  mision     LudiMision    @relation(fields: [misionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([activityId, misionId])
  @@map("LUDI_ACTIVIDAD_MISION")
}

// Insignias y misiones que ganó cada estudiante; la PK evita otorgar dos veces.
model LudiParticipanteInsignia {
  participanteId BigInt                   @map("participante_id")
  insigniaId     Int                      @map("insignia_id")
  otorgadoEn     DateTime                 @default(dbgenerated("sysdatetime()")) @map("otorgado_en")
  participante   LUDI_SESION_PARTICIPANTE @relation(fields: [participanteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  insignia       LudiInsignia             @relation(fields: [insigniaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([participanteId, insigniaId])
  @@map("LUDI_PARTICIPANTE_INSIGNIA")
}

model LudiParticipanteMision {
  participanteId BigInt                   @map("participante_id")
  misionId       Int                      @map("mision_id")
  otorgadoEn     DateTime                 @default(dbgenerated("sysdatetime()")) @map("otorgado_en")
  participante   LUDI_SESION_PARTICIPANTE @relation(fields: [participanteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mision         LudiMision               @relation(fields: [misionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([participanteId, misionId])
  @@map("LUDI_PARTICIPANTE_MISION")
}

model LudiRol {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.NVarChar(50)
  descripcion String?    @db.NVarChar(200)
  users       LudiUser[]

  @@map("LUDI_ROL")
}

model LudiUser {
  id             String               @id @default(uuid())
  firebaseUid    String?              @map("firebase_uid") @db.NVarChar(128)
  email          String?              @db.NVarChar(160)
  nombre         String               @db.NVarChar(120)
  username       String?              @db.NVarChar(50)
  passwordHash   String?              @map("password_hash") @db.NVarChar(256)
  rolId          Int                  @map("rol_id")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  rol            LudiRol              @relation(fields: [rolId], references: [id], onUpdate: NoAction, map: "FK_LUDI_USER_ROL")
  actividades    LudiActividad[]
  sesiones       LUDI_SESION[]
  config         LudiUserConfig?
  materias       LudiUsuarioMateria[]
  notificaciones LudiNotificacion[]

  @@map("LUDI_USERS")
}

// Clases (asignaturas) que imparte un educador. Catálogo como datos, igual que
// insignias y misiones: prisma/seeds/subjectCatalog.ts. El texto se lee por
// codigo en messages (Subjects.<codigo>), así que codigo no debe cambiar.
model LudiMateria {
  id     Int     @id @default(autoincrement())
  codigo String  @unique(map: "UQ_LUDI_MATERIA_codigo") @db.NVarChar(40)
  orden  Int     @default(0)
  // Retirar una clase es activo = false: las FK impiden borrarla mientras esté elegida.
  activo Boolean @default(true)

  grados      LudiMateriaGrado[]
  usuarios    LudiUsuarioMateria[]
  plantillas  LudiPlantilla[]
  colecciones LudiPlantillaColeccion[]

  @@map("LUDI_MATERIA")
}

// En qué grados se ofrece cada clase.
model LudiMateriaGrado {
  materiaId Int               @map("materia_id")
  gradoId   Int               @map("grado_id")
  materia   LudiMateria       @relation(fields: [materiaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  grado     LUDI_COMMON_GRADE @relation(fields: [gradoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([materiaId, gradoId])
  @@map("LUDI_MATERIA_GRADO")
}

// Clases que el educador eligió para cada grado; base para proponerle actividades.
model LudiUsuarioMateria {
  userId    String            @map("user_id")
  gradoId   Int               @map("grado_id")
  materiaId Int               @map("materia_id")
  creadoEn  DateTime          @default(now()) @map("creado_en")
  user      LudiUser          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  grado     LUDI_COMMON_GRADE @relation(fields: [gradoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  materia   LudiMateria       @relation(fields: [materiaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, gradoId, materiaId])
  @@map("LUDI_USUARIO_MATERIA")
}

model LudiUserConfig {
  userId                  String  @id @map("user_id")
  defaultTimeLimitMs      Int     @default(30000) @map("default_time_limit_ms")
  defaultPoints           Int     @default(100) @map("default_points")
  defaultVoiceEnabled     Boolean @default(true) @map("default_voice_enabled")
  defaultIsPublic         Boolean @default(false) @map("default_is_public")
  enableStudentFeedback   Boolean @default(true) @map("enable_student_feedback")
  enableTeacherEvaluation Boolean @default(true) @map("enable_teacher_evaluation")
  toursEnabled            Boolean @default(true) @map("tours_enabled")
  tourMode                String  @default("full") @map("tour_mode") @db.NVarChar(20)
  completedTours          String  @default("[]") @map("completed_tours") @db.NVarChar(Max)
  // Voz que narra los logros al estudiante: female | male y slow | normal | fast (ver voiceProfile.ts).
  voiceGender             String  @default("female") @map("voice_gender") @db.NVarChar(10)
  voiceSpeed              String  @default("normal") @map("voice_speed") @db.NVarChar(10)
  // Tipos de notificación que el docente apagó, como lista JSON (ver features/notifications).
  mutedNotifications      String  @default("[]") @map("muted_notifications") @db.NVarChar(400)

  user LudiUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("LUDI_USER_CONFIG")
}

// Avisos del panel docente (campana). Una por usuario y clave: el mismo hecho (p. ej.
// las respuestas por calificar de una sesión) actualiza su aviso en vez de repetirlo.
// El texto se arma en el cliente desde messages (Notifications.types.<tipo>) con datos.
model LudiNotificacion {
  id            BigInt   @id @default(autoincrement())
  userId        String   @map("user_id")
  tipo          String   @db.NVarChar(40)
  clave         String   @db.NVarChar(120)
  datos         String   @default("{}") @db.NVarChar(Max)
  enlace        String?  @db.NVarChar(300)
  leida         Boolean  @default(false)
  creadaEn      DateTime @default(now()) @map("creada_en")
  actualizadaEn DateTime @default(now()) @map("actualizada_en")
  user          LudiUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, clave], map: "UQ_LUDI_NOTIFICACION_user_clave")
  @@index([userId, actualizadaEn], map: "IX_LUDI_NOTIFICACION_user_fecha")
  @@map("LUDI_NOTIFICACION")
}

model LudiAvatar {
  id            Int                        @id @default(autoincrement())
  nombre        String                     @db.NVarChar(100)
  urlImagen     String                     @map("urlImagen") @db.NVarChar(600)
  activo        Boolean                    @default(true)
  participantes LUDI_SESION_PARTICIPANTE[]

  @@map("LudiAvatar")
}

model LudiRespuestaEstudiante {
  id                Int      @id @default(autoincrement())
  participanteId    BigInt
  preguntaId        BigInt
  opcionId          BigInt?
  respuestaBooleana Boolean?
  esCorrecta        Boolean
  tiempoRespuestaMs Int
  puntajeObtenido   Int
  // LudiForm: texto escrito (respuesta larga) y opciones marcadas (selección múltiple, JSON de ids).
  respuestaTexto    String?  @db.NVarChar(Max)
  opcionesJson      String?  @db.NVarChar(400)
  // "PENDIENTE" mientras el docente no califica una respuesta escrita; "REVISADA" después.
  estadoRevision    String?  @db.NVarChar(20)

  participante LUDI_SESION_PARTICIPANTE @relation(fields: [participanteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pregunta     LudiPregunta             @relation(fields: [preguntaId], references: [id], onDelete: NoAction, onUpdate: NoAction) // THIS IS THE LINE TO FIX
  opcion       LudiOpcion?              @relation(fields: [opcionId], references: [id], onDelete: NoAction, onUpdate: NoAction) // THIS IS THE LINE TO FIX

  @@map("LudiRespuestaEstudiante")
}

// Catálogo de plantillas (src/features/templates). La actividad es una LudiActividad
// normal con ACTIVITY.isTemplate; aquí vive lo que solo tiene una plantilla: su código
// estable en el catálogo (catalog/*.json), su clase, su colección y su portada.
model LudiPlantilla {
  activityId     Int                     @id @map("activity_id")
  codigo         String                  @unique(map: "UQ_LUDI_PLANTILLA_codigo") @db.NVarChar(80)
  materiaId      Int                     @map("materia_id")
  coleccionId    Int?                    @map("coleccion_id")
  orden          Int                     @default(0)
  portadaUrl     String?                 @map("portada_url") @db.NVarChar(600)
  portadaCredito String?                 @map("portada_credito") @db.NVarChar(200)
  duracionMin    Int                     @default(5) @map("duracion_min")
  // Huella del contenido del catálogo: sincronizar sin cambios no reescribe la actividad.
  version        String                  @db.NVarChar(64)
  actividad      LudiActividad           @relation(fields: [activityId], references: [activityId], onDelete: Cascade, onUpdate: NoAction)
  materia        LudiMateria             @relation(fields: [materiaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coleccion      LudiPlantillaColeccion? @relation(fields: [coleccionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([materiaId], map: "IX_LUDI_PLANTILLA_materia")
  @@map("LUDI_PLANTILLA")
}

// Colección temática de plantillas de un grado y una clase (p. ej. "Las vocales").
// No es LUDI_TEMA: ese nombre ya lo usan los fondos de pantalla de las actividades.
model LudiPlantillaColeccion {
  id             Int               @id @default(autoincrement())
  codigo         String            @unique(map: "UQ_LUDI_PLANTILLA_COLECCION_codigo") @db.NVarChar(80)
  gradoId        Int               @map("grado_id")
  materiaId      Int               @map("materia_id")
  nombre         String            @db.NVarChar(120)
  descripcion    String?           @db.NVarChar(300)
  portadaUrl     String?           @map("portada_url") @db.NVarChar(600)
  portadaCredito String?           @map("portada_credito") @db.NVarChar(200)
  orden          Int               @default(0)
  activo         Boolean           @default(true)
  grado          LUDI_COMMON_GRADE @relation(fields: [gradoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  materia        LudiMateria       @relation(fields: [materiaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plantillas     LudiPlantilla[]

  @@map("LUDI_PLANTILLA_COLECCION")
}
